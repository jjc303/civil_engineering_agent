# Copy to .env for local development. Never commit the real .env file.

# MySQL (WSL local default)
AGENT_DATABASE_URL=mysql+pymysql://root:REPLACE_WITH_DATABASE_PASSWORD@127.0.0.1:3307/safety_agent?charset=utf8mb4

# Internal CV → Agent request authentication
INTERNAL_PERCEPTION_TOKEN=REPLACE_WITH_A_RANDOM_SECRET

# DeepSeek. Use fake when no real model call is required.
AGENT_LLM_PROVIDER=deepseek
AGENT_LLM_MODEL=deepseek-flash
AGENT_LLM_BASE_URL=https://api.deepseek.com
AGENT_LLM_API_KEY=REPLACE_WITH_DEEPSEEK_API_KEY
AGENT_LLM_TIMEOUT_SECONDS=20
AGENT_TOOL_MAX_CALLS=2

# Local-only shortcut. Use Alembic migrations for shared/production MySQL.
AGENT_AUTO_CREATE_SCHEMA=false

# Optional short-term browser-session memory (MySQL) and local Chroma RAG.
AGENT_MEMORY_ENABLED=true
AGENT_MEMORY_TTL_HOURS=24
AGENT_MEMORY_RECENT_TURNS=6
AGENT_RAG_ENABLED=false
AGENT_RAG_PERSIST_DIRECTORY=./runs/chroma
AGENT_RAG_DOCUMENT_DIRECTORY=./runs/knowledge
AGENT_RAG_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
AGENT_RAG_CHUNK_SIZE=800
AGENT_RAG_CHUNK_OVERLAP=120
AGENT_RAG_TOP_K=4
AGENT_RAG_TOP_K_MAX=8
AGENT_RAG_MAX_UPLOAD_BYTES=20971520
AGENT_RAG_ALLOWED_EXTENSIONS=.pdf,.docx,.md,.txt

# Bindings and browser origins are deployment-specific; set every value.
AGENT_BIND_HOST=0.0.0.0
AGENT_PORT=8000
AGENT_CORS_ORIGINS=http://YOUR_WEB_HOST:5173
AGENT_URL=http://YOUR_AGENT_HOST:8000
WEB_BIND_HOST=0.0.0.0
WEB_PORT=5173
CV_BIND_HOST=0.0.0.0
CV_CONTROL_PORT=8100
CV_NODE_ID=YOUR_CV_NODE_ID
CV_NODE_DISPLAY_NAME=YOUR_CV_NODE_DISPLAY_NAME
CV_NODE_CONTROL_URL=http://YOUR_CV_HOST:8100
CV_NODE_CAPACITY=1
CV_ALLOWED_MEDIA_ROOTS=YOUR_ALLOWED_MEDIA_ROOT
AGENT_MEDIA_ROOT=YOUR_AGENT_MEDIA_ROOT
CV_SNAPSHOT_DIR=YOUR_SNAPSHOT_DIRECTORY
LOCAL_CAMERA_ID=YOUR_CAMERA_ID
LOCAL_CAMERA_DISPLAY_NAME=YOUR_CAMERA_DISPLAY_NAME
LOCAL_CAMERA_SOURCE_TYPE=file
LOCAL_CAMERA_SOURCE=YOUR_CAMERA_SOURCE
