# Portable local review configuration. Run python -m scripts.start_review --init.
AGENT_DATABASE_URL=sqlite:///./runs/review.db
INTERNAL_PERCEPTION_TOKEN=GENERATE_INTERNAL_TOKEN
AGENT_CREDENTIAL_ENCRYPTION_KEY=GENERATE_ENCRYPTION_KEY
AGENT_LLM_PROVIDER=deepseek
AGENT_LLM_MODEL=deepseek-flash
AGENT_LLM_BASE_URL=https://api.deepseek.com
AGENT_LLM_API_KEY=
AGENT_LLM_TIMEOUT_SECONDS=90
AGENT_TOOL_MAX_CALLS=2
AGENT_AUTO_CREATE_SCHEMA=false
AGENT_BIND_HOST=127.0.0.1
AGENT_PORT=8000
AGENT_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
AGENT_MEDIA_ROOT=./runs/media
AGENT_URL=http://127.0.0.1:8000
LEARNING_PUBLIC_BASE_URL=http://127.0.0.1:8000
LEARNING_TIMEZONE=Asia/Shanghai
LEARNING_REPORT_DIRECTORY=./runs/learning/reports
AGENT_MEMORY_ENABLED=true
# First start without RAG. Enable after placing the full local embedding model.
AGENT_RAG_ENABLED=false
AGENT_RAG_EMBEDDING_PROVIDER=sentence_transformers
AGENT_RAG_EMBEDDING_MODEL=./runs/models/bge-small-zh-v1.5
AGENT_RAG_EMBEDDING_DIMENSIONS=512
AGENT_RAG_PERSIST_DIRECTORY=./runs/chroma-review
AGENT_RAG_DOCUMENT_DIRECTORY=./runs/knowledge
AGENT_RAG_INBOX_DIRECTORY=./knowledge
AGENT_RAG_STANDARDS_SUBDIRECTORY=standard
AGENT_RAG_ACCIDENT_REPORTS_SUBDIRECTORY=accident_reports
AGENT_RAG_SYNC_INTERVAL_SECONDS=30
AGENT_RAG_MAX_UPLOAD_BYTES=41943040
CV_NODE_ID=review-local
CV_NODE_TOKEN=GENERATE_CV_TOKEN
CV_NODE_CAPACITY=2
CV_CONTROL_PORT=8100
CV_ALLOWED_MEDIA_ROOTS=./runs/input/videos
CV_SNAPSHOT_DIR=./runs/media/snapshots
